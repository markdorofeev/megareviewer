diff --git a/src/members/repository.ts b/src/members/repository.ts
index 3669b96..94d7fb3 100644
--- a/src/members/repository.ts
+++ b/src/members/repository.ts
@@ -11,3 +11,18 @@ export const listMembers = (db: Db, projectId: string): Promise<Member[]> =>
     "SELECT id, name, role FROM project_members WHERE project_id = $1 ORDER BY name, id",
     [projectId],
   );
+
+/** Removes a member from a project, and says whether there was one to remove. Owners stay. */
+export const removeMember = async (
+  db: Db,
+  projectId: string,
+  memberId: string,
+): Promise<boolean> => {
+  const removed = await db.query<{ id: string }>(
+    `DELETE FROM project_members
+     WHERE project_id = $1 AND id = $2 AND role <> 'owner'
+     RETURNING id`,
+    [projectId, memberId],
+  );
+  return removed.length > 0;
+};
