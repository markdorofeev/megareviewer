{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/coverage",
      "!!evals/results",
      "!!evals/cases/*/files",
      "!!**/test-results",
      "!!**/playwright-report",
      "!**/fixtures/**/*.json",
      "!.idea",
      "!!.claude",
      "!!hunk-design-system"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "correctness": {
        "useImportExtensions": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/src/review/diff/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    },
    {
      "includes": ["web/src/styles/globals.css"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["src/cli/**", "scripts/**", "evals/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
